{
  "name": "lean-oracle-watchdog",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Lean Oracle watchdog: checks publishers and the mirror, and alerts on Telegram. Distributed as a Docker image.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test 'tests/**/*.test.mjs'"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
