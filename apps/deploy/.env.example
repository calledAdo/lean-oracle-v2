# Copy to .env (git-ignored). Per network: a deployer key (hex or a file path) and an optional RPC override.
TESTNET_DEPLOYER_KEY_FILE=../../secrets/testnet-deployer.key
# TESTNET_DEPLOYER_PRIVATE_KEY=0x...
# TESTNET_CKB_RPC_URL=https://testnet.ckb.dev/rpc
# MAINNET_DEPLOYER_KEY_FILE=
# DEVNET_DEPLOYER_PRIVATE_KEY=0x...   (offckb genesis account #0)

# Transactions are only sent with BROADCAST=true (or --broadcast); otherwise every action is a dry run.
# BROADCAST=true
