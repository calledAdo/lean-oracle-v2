{
  "name": "lean-oracle-publisher",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Lean Oracle publisher: records exchange data, observes each tick, and co-signs committee price updates. Distributed as a Docker image.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test tests/"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1139.0",
    "lean-oracle-sdk": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
